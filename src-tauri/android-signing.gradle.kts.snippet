
// --- Release signing, appended by .github/workflows/release.yml after `tauri android init` ---
// Values come from environment variables that CI sets from GitHub secrets.
// (Avoid `java.util...` here: inside `android {}` the name `java` resolves to the Java extension.)
android {
    signingConfigs {
        create("release") {
            storeFile = file(System.getenv("ANDROID_KEYSTORE_FILE"))
            storePassword = System.getenv("ANDROID_KEYSTORE_PASSWORD")
            keyAlias = System.getenv("ANDROID_KEY_ALIAS")
            keyPassword = System.getenv("ANDROID_KEYSTORE_PASSWORD")
        }
    }
    buildTypes {
        getByName("release") {
            signingConfig = signingConfigs.getByName("release")
        }
    }
}
